# ===== Chaves de IA =====
GEMINI_API_KEY=AQ...
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-proj-...
# Chaves de pesquisa / dados
TAVILY_API_KEY=tvly-...
SERPER_API_KEY=...
RAWG_API_KEY=...
STABILITY_API_KEY=...

# ===== Mercado Livre (afiliados) =====
ML_CLIENT_ID=...
ML_CLIENT_SECRET=...
ML_AFFILIATE_TAG=...

# ===== Monitor de API remoto (sourcing) =====
MONITOR_API_URL=http://34.29.27.155:8086
MONITOR_API_KEY=
# legacy exige SERPER_API_KEY; remote usa a Monitor API
AFFILIATE_MODE=remote

# ===== Automação / GitHub =====
GITHUB_TOKEN=github_pat_...
ADMIN_API_KEY=...
JWT_SECRET=...

# ===== ML cookies (busca de produtos sem credencial) =====
ML_COOKIES_B64=...
ML_COOKIES_PATH=ml_cookies.json

# ===== Comportamento do pipeline (opcional) =====
# Janela (em dias) em que uma familia publicada bloqueia re-cobertura na descoberta
FAMILY_REFRESH_DAYS=30
# Minimo de produtos validos para artigo de lista/review abortar
MIN_PRODUCTS=3
# Tema deterministico: FORCE_TOPIC="keyword|categoria"
FORCE_TOPIC=
# Pular geracao de capa por IA (usar fallback)
SKIP_COVER=false
# Publicar mesmo se o gate de revisao reprovar (escape do operador)
IGNORE_REVIEW_GATE=false
# Ignorar cooldown de 20h e gerar agora
FORCE_GENERATE=false
