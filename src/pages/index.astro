---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Sidebar from "../components/Sidebar.astro";

const artigos = Object.entries(import.meta.glob("../content/artigos/*.md", { eager: true }))
  .map(([path, mod]) => ({
    slug: path.split("/").pop()?.replace(".md", "") || "",
    ...mod.frontmatter,
    Content: mod.Content,
  }))
  .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());

const [destaque, ...restante] = artigos;
const maisLidos = artigos.filter((a) => a.slug !== destaque?.slug);
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
---

<Layout title="Promo Gamer" image={`${base}images/banner-grupo.webp`}>
  <div class="w-full">
    <script>
      (function() {
        const params = new URLSearchParams(window.location.search);
        if (params.has("categoria") || params.has("tag")) {
          const meta = document.createElement("meta");
          meta.name = "robots";
          meta.content = "noindex, follow";
          document.head.appendChild(meta);
          const clean = window.location.origin + window.location.pathname;
          let canonical = document.querySelector('link[rel="canonical"]');
          if (canonical) {
            canonical.href = clean;
          } else {
            canonical = document.createElement("link");
            canonical.rel = "canonical";
            canonical.href = clean;
            document.head.appendChild(canonical);
          }
        }
      })();
    </script>
    <div class="w-full max-w-page mx-auto px-margin-mobile lg:px-gutter mt-lg mb-xl grid grid-cols-1 lg:grid-cols-12 gap-lg">
      <div class="col-span-1 lg:col-span-8 flex flex-col gap-lg">
        {destaque && (
          <HeroSection
            title={destaque.title}
            description={destaque.description}
            pubDate={destaque.pubDate}
            tags={destaque.tags}
            category={destaque.category}
            affiliate={destaque.affiliate}
            slug={destaque.slug}
            image={destaque.image}
          />
        )}

        <section>
          <div class="flex items-center justify-between mb-md">
            <h2 class="font-headline-lg text-headline-lg text-on-background flex items-center gap-sm">
              <span class="material-symbols-outlined text-primary text-[32px]" aria-hidden="true">bolt</span>
              Últimas Atualizações
            </h2>
            <a
              href={`${base}categoria/noticia/`}
              class="text-primary hover:text-primary-fixed-dim transition-colors font-label-md text-label-md uppercase flex items-center gap-1 group no-underline hover:no-underline"
            >
              Ver todas
              <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform" aria-hidden="true">arrow_forward</span>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
            {restante.map((artigo) => (
              <ArticleCard
                title={artigo.title}
                description={artigo.description}
                pubDate={artigo.pubDate}
                tags={artigo.tags}
                category={artigo.category}
                affiliate={artigo.affiliate}
                slug={artigo.slug}
                image={artigo.image}
              />
            ))}
          </div>
        </section>
      </div>

      <aside class="col-span-1 lg:col-span-4 flex flex-col gap-lg">
        <Sidebar artigos={artigos} currentSlug={destaque?.slug} />
      </aside>
    </div>

    <a
      href="https://t.me/+TRWZ67WHuk85Y2Nh"
      target="_blank"
      rel="noopener noreferrer"
      class="block max-w-page mx-auto px-margin-mobile lg:px-gutter pb-xl no-underline hover:no-underline"
    >
      <img
        src={`${base}images/banner-grupo.webp`}
        alt="Grupo VIP Telegram - Ofertas Gamer Diárias"
        class="w-full h-auto rounded-xl"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>

  {!destaque && (
    <div class="pt-16 max-w-page mx-auto px-margin-mobile lg:px-gutter py-xl">
      <section class="text-center py-xl">
        <p style="font-size: 3rem; margin-bottom: 1rem;">&#x1F3AE;</p>
        <h1 class="font-headline-lg text-headline-lg mb-md">
          Bem-vindo ao <span class="text-primary">Promo Gamer</span>
        </h1>
        <p class="text-on-surface-variant text-body-lg max-w-lg mx-auto mb-lg">
          Notícias, reviews, listas e guias sobre o universo dos games.
        </p>
        <div class="flex gap-sm justify-center flex-wrap">
          <span class="inline-block bg-primary/10 text-primary border border-primary/20 rounded-full px-md py-xs font-label text-[0.65rem] uppercase tracking-widest">notícias</span>
          <span class="inline-block bg-primary/10 text-primary border border-primary/20 rounded-full px-md py-xs font-label text-[0.65rem] uppercase tracking-widest">reviews</span>
          <span class="inline-block bg-primary/10 text-primary border border-primary/20 rounded-full px-md py-xs font-label text-[0.65rem] uppercase tracking-widest">guias</span>
          <span class="inline-block bg-primary/10 text-primary border border-primary/20 rounded-full px-md py-xs font-label text-[0.65rem] uppercase tracking-widest">listas</span>
        </div>
      </section>
    </div>
  )}
</Layout>
