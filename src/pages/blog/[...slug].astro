---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import Sidebar from "../../components/Sidebar.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { extractHeadings } from "../../lib/headings";

export async function getStaticPaths() {
  const artigos = Object.entries(import.meta.glob("../../content/artigos/*.md", { eager: true }));
  const rawArtigos = import.meta.glob("../../content/artigos/*.md", { query: "?raw", import: "default", eager: true });

  return artigos.map(([path, mod]) => ({
    params: { slug: path.split("/").pop()?.replace(".md", "") },
    props: {
      frontmatter: mod.frontmatter,
      Content: mod.Content,
      headings: extractHeadings(rawArtigos[path]),
    },
  }));
}

const { frontmatter, Content, headings } = Astro.props;
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
const slug = Astro.params.slug;

const todosArtigos = Object.entries(import.meta.glob("../../content/artigos/*.md", { eager: true }))
  .map(([path, mod]) => ({
    slug: path.split("/").pop()?.replace(".md", "") || "",
    title: mod.frontmatter.title,
    pubDate: mod.frontmatter.pubDate,
    category: mod.frontmatter.category,
    image: mod.frontmatter.image,
  }))
  .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());

  const readingTime = Math.max(1, Math.ceil(Content ? 1 : (frontmatter.description || "").split(" ").length / 200));
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  pubDate={frontmatter.pubDate}
  tags={frontmatter.tags}
  category={frontmatter.category}
>
  <div class="fixed top-0 left-0 w-full h-[3px] z-50" id="readingProgress">
    <div id="readingProgressBar" class="h-full bg-[#2ff801] shadow-[0_0_8px_rgba(47,248,1,0.5)] w-0 transition-[width] duration-150 ease-out"></div>
  </div>

  <div class="relative z-10 pb-xxl px-gutter">
    <div class="max-w-page mx-auto">
      <div class="grid grid-cols-1 gap-xl my-xl blog-layout">
        <article class="min-w-0 w-full" id="articleContent" style="grid-column: span var(--main-cols, 8) / span var(--main-cols, 8)">
        {frontmatter.image && (
          <div class="rounded-xl overflow-hidden mb-xl shadow-2xl group">
            <img
              src={frontmatter.image}
              alt={frontmatter.title}
              class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-700"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )}

        <div class="flex flex-wrap gap-sm mb-md">
          {frontmatter.category && (
            <span class="px-sm py-1 bg-primary/10 text-primary border border-primary/20 rounded-full font-label text-label uppercase tracking-widest">
              {frontmatter.category}
            </span>
          )}
          {frontmatter.tags?.slice(0, 3).map((tag) => (
            <span class="px-sm py-1 bg-primary/10 text-primary border border-primary/20 rounded-full font-label text-label uppercase tracking-widest">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="font-h1 text-h1 text-white mb-md leading-tight">
          {frontmatter.title}
        </h1>

        <div class="flex items-center gap-md mb-xl text-outline font-label text-label">
          <div class="flex items-center gap-xs">
              <Icon name="person" size={18} />
            <span>BLOG GAMER</span>
          </div>
          <div class="w-1 h-1 bg-outline-variant/40 rounded-full" />
          <div class="flex items-center gap-xs">
              <Icon name="calendar_today" size={18} />
            <span>{new Date(frontmatter.pubDate).toLocaleDateString("pt-BR")}</span>
          </div>
          <div class="w-1 h-1 bg-outline-variant/40 rounded-full" />
          <span>{readingTime} MIN DE LEITURA</span>
        </div>

        <TableOfContents headings={headings} />

        <div class="font-body text-body text-on-surface-variant leading-relaxed" id="articleBody">
          <Content />
        </div>

        <div class="mt-xl pt-xl border-t border-white/10">
          <div class="flex flex-wrap gap-sm items-center">
            <span class="text-outline font-label text-label mr-md self-center">TAGS:</span>
            {frontmatter.tags?.map((tag) => (
              <a
                href={`${base}?tag=${tag}`}
                class="px-md py-1 rounded-full border border-primary/30 text-primary bg-primary/5 hover:bg-primary/10 transition-colors font-label text-label no-underline hover:no-underline"
              >
                {tag.toUpperCase()}
              </a>
            ))}
          </div>
        </div>

        <a
          href="https://t.me/+TRWZ67WHuk85Y2Nh"
          target="_blank"
          rel="noopener noreferrer"
          class="block my-xl rounded-lg overflow-hidden card-depth no-underline hover:no-underline"
        >
          <img
            src={`${base}images/banner-grupo.webp`}
            alt="Grupo VIP Telegram - Ofertas Gamer Diárias"
            class="w-full h-auto"
            loading="lazy"
            decoding="async"
          />
        </a>

        <div class="mt-xl p-lg bg-surface-container rounded-xl border border-outline-variant/10 text-center">
          <p class="text-on-surface-variant text-xs mb-sm">
            Gostou do conteúdo? Compartilhe com outros gamers!
          </p>
          <p class="text-on-surface-variant/60 text-[10px] mb-md">
            Links de afiliado ajudam a manter o blog.
          </p>
          <a
            href={base}
            class="inline-flex items-center gap-sm px-lg py-md rounded-lg border border-outline-variant/20 text-on-surface-variant hover:text-primary hover:border-primary transition-colors font-label text-label no-underline hover:no-underline"
          >
              <Icon name="arrow_back" size={14} />
            VOLTAR AO INÍCIO
          </a>
        </div>
      </article>

      <aside class="min-w-0" style="grid-column: span var(--sidebar-cols, 4) / span var(--sidebar-cols, 4)">
        <Sidebar artigos={todosArtigos} currentSlug={slug} />
      </aside>
      </div>
    </div>
  </div>

  <script>
    const progressBar = document.getElementById("readingProgressBar");
    if (progressBar) {
      window.addEventListener("scroll", () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? Math.min((scrollTop / docHeight) * 100, 100) : 0;
        progressBar.style.width = progress + "%";
      }, { passive: true });
    }

    const observerOptions = { threshold: 0, rootMargin: "0px 0px 200px 0px" };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("opacity-100", "translate-y-0");
          entry.target.classList.remove("opacity-0", "translate-y-10");
        }
      });
    }, observerOptions);

    const viewportHeight = window.innerHeight;
    document.querySelectorAll("#articleContent > *").forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < viewportHeight + 100) {
        el.classList.add("opacity-100", "translate-y-0");
      } else {
        el.classList.add("transition-all", "duration-700", "opacity-0", "translate-y-10");
        observer.observe(el);
      }
    });

    let lightbox = null;
    function openLightbox(src, alt) {
      if (lightbox) lightbox.remove();
      lightbox = document.createElement("div");
      lightbox.className = "lightbox-overlay";
      lightbox.innerHTML = `<div class="lightbox-backdrop"></div><img src="${src}" alt="${alt}" class="lightbox-img"><button class="lightbox-close">&times;</button>`;
      document.body.appendChild(lightbox);
      requestAnimationFrame(() => lightbox.classList.add("active"));
      lightbox.querySelector(".lightbox-backdrop").addEventListener("click", closeLightbox);
      lightbox.querySelector(".lightbox-close").addEventListener("click", closeLightbox);
      document.addEventListener("keydown", onLightboxKey);
    }
    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove("active");
      document.removeEventListener("keydown", onLightboxKey);
      setTimeout(() => { if (lightbox) { lightbox.remove(); lightbox = null; } }, 300);
    }
    function onLightboxKey(e) { if (e.key === "Escape") closeLightbox(); }

    document.querySelectorAll("#articleBody img").forEach((img) => {
      img.style.cursor = "pointer";
      img.addEventListener("click", () => openLightbox(img.src, img.alt));
    });


  </script>

  <style is:global>
    /* === Lightbox === */
    .lightbox-overlay {
      position: fixed; inset: 0; z-index: 9999;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
    }
    .lightbox-overlay.active { opacity: 1; pointer-events: auto; }
    .lightbox-backdrop {
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.92);
    }
    .lightbox-img {
      position: relative; z-index: 1;
      max-width: 90vw; max-height: 90vh;
      object-fit: contain;
      border-radius: 10px;
      box-shadow: 0 0 60px rgba(168,85,247,0.15);
      transform: scale(0.9); transition: transform 0.3s ease;
    }
    .lightbox-overlay.active .lightbox-img { transform: scale(1); }
    .lightbox-close {
      position: absolute; top: 24px; right: 32px; z-index: 2;
      background: none; border: none;
      color: #fff; font-size: 2rem; cursor: pointer;
      opacity: 0.7; transition: opacity 0.2s;
    }
    .lightbox-close:hover { opacity: 1; }

    /* === Article Game Images === */
    #articleBody .article-game-img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 1.5rem auto;
      object-fit: contain;
      background: var(--bg-card, #0A0A0F);
      border-radius: var(--radius, 10px);
      border: 1px solid var(--border, #1C1C2E);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    #articleBody .article-game-img:hover {
      transform: scale(1.02);
      box-shadow: 0 4px 20px rgba(168,85,247,0.15);
    }

    /* === Article body font size === */
    #articleBody {
      font-size: 1.2rem;
      line-height: 1.85;
    }
    #articleBody p {
      font-size: 1.2rem;
      line-height: 1.85;
      margin-bottom: 1.5rem;
    }
    #articleBody ul, #articleBody ol {
      margin-bottom: 1.5rem;
    }
    #articleBody li {
      margin-bottom: 0.5rem;
    }
    #articleBody pre {
      white-space: pre-wrap;
      overflow-wrap: break-word;
    }
    #articleBody blockquote {
      margin: 1.5rem 0;
    }
    /* === Product Cards === */
    #articleBody .product-card {
      background: var(--bg-card, #0A0A0F);
      border: 1px solid var(--border, #1C1C2E);
      border-radius: var(--radius-lg, 14px);
      overflow: hidden;
      margin-bottom: 1.75rem;
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }
    #articleBody .product-card:hover {
      border-color: var(--accent, #A855F7);
      box-shadow: 0 0 24px rgba(168, 85, 247, 0.1);
    }
    #articleBody .product-card-img {
      width: 100%;
      max-width: 600px;
      object-fit: contain;
      aspect-ratio: auto;
      display: block;
      border-radius: 0;
      cursor: pointer;
    }
    #articleBody .product-card-body {
      padding: 1.25rem;
    }
    #articleBody .product-card-body h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-primary, #efecfb);
      margin: 0 0 0.5rem 0;
      line-height: 1.3;
    }
    #articleBody .product-price {
      color: var(--accent, #A855F7);
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }
    #articleBody .product-desc {
      color: var(--text-secondary, #aca9b7);
      line-height: 1.7;
      margin-bottom: 1rem;
      font-size: 0.95rem;
    }
    #articleBody .product-pros {
      margin-bottom: 0.5rem;
      padding: 0.75rem 1rem;
      background: rgba(47, 248, 1, 0.04);
      border-left: 3px solid #2ff801;
      border-radius: 0 8px 8px 0;
      font-size: 0.9rem;
      color: var(--text-secondary, #aca9b7);
      line-height: 1.7;
    }
    #articleBody .product-pros strong {
      color: #2ff801;
    }
    #articleBody .product-cons {
      margin-bottom: 0.5rem;
      padding: 0.75rem 1rem;
      background: rgba(239, 68, 68, 0.04);
      border-left: 3px solid #ef4444;
      border-radius: 0 8px 8px 0;
      font-size: 0.9rem;
      color: var(--text-secondary, #aca9b7);
      line-height: 1.7;
    }
    #articleBody .product-cons strong {
      color: #ef4444;
    }
    #articleBody .product-btn {
      display: block;
      width: 100%;
      max-width: 420px;
      padding: 0.875rem 1.5rem;
      background: #2ff801;
      color: #000;
      font-family: var(--font-label, "Public Sans", sans-serif);
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-align: center;
      border-radius: 10px;
      text-decoration: none;
      transition: all 0.3s ease;
      margin: 1.5rem auto 0;
      border: none;
      cursor: pointer;
    }
    #articleBody .product-btn:hover {
      box-shadow: 0 0 20px rgba(47, 248, 1, 0.4);
      transform: scale(1.02);
      color: #000;
      text-decoration: none;
    }
    #articleBody .product-btn:active {
      transform: scale(0.98);
    }
    #articleBody .product-btn-amarelo { background: #fde047; color: #1c1917; }
    #articleBody .product-btn-amarelo:hover { box-shadow: 0 0 20px rgba(250, 204, 21, 0.4); color: #1c1917; }
    #articleBody .product-btn-vermelho { background: #ef4444; color: #fff; }
    #articleBody .product-btn-vermelho:hover { box-shadow: 0 0 20px rgba(239, 68, 68, 0.4); color: #fff; }
    #articleBody .product-btn-azul { background: #3b82f6; color: #fff; }
    #articleBody .product-btn-azul:hover { box-shadow: 0 0 20px rgba(59, 130, 246, 0.4); color: #fff; }
    #articleBody .product-btn-verde { background: #2ff801; color: #000; }
    #articleBody .product-btn-verde:hover { box-shadow: 0 0 20px rgba(47, 248, 1, 0.4); color: #000; }
    #articleBody .product-btn-laranja { background: #f97316; color: #fff; }
    #articleBody .product-btn-laranja:hover { box-shadow: 0 0 20px rgba(249, 115, 22, 0.4); color: #fff; }
    #articleBody .product-btn-roxo { background: #a855f7; color: #fff; }
    #articleBody .product-btn-roxo:hover { box-shadow: 0 0 20px rgba(168, 85, 247, 0.4); color: #fff; }
    #articleBody .product-btns {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
      max-width: 420px;
      margin: 1.5rem auto 0;
    }
    #articleBody .product-btns .product-btn {
      margin: 0;
      flex: 1 1 180px;
      width: auto;
    }
    #articleBody .product-btn--ml { background: #ffe600; color: #000; }
    #articleBody .product-btn--shopee { background: #ee4d2d; color: #fff; }

    /* === Tabela Comparativa === */
    #articleBody table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 2rem 0;
      font-size: 0.95rem;
      border-radius: var(--radius, 10px);
      overflow: hidden;
      border: 1px solid var(--border, #1C1C2E);
    }
    #articleBody th {
      background: var(--bg-elevated, #12121D);
      color: var(--accent, #A855F7);
      font-weight: 700;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.75rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border, #1C1C2E);
    }
    #articleBody td {
      padding: 0.75rem 1rem;
      color: var(--text-secondary, #aca9b7);
      border-bottom: 1px solid var(--border, #1C1C2E);
    }
    #articleBody tr:last-child td {
      border-bottom: none;
    }
    #articleBody tr:hover td {
      background: rgba(168, 85, 247, 0.04);
    }
    #articleBody tr:nth-child(even) td {
      background: rgba(168, 85, 247, 0.03);
    }

    /* === FAQ === */
    #articleBody h3 strong {
      color: var(--accent, #A855F7);
    }
    #articleBody ul:has(strong) {
      padding-left: 0;
      list-style: none;
    }
    #articleBody ul li strong:first-child {
      color: var(--text-primary, #efecfb);
    }

    /* === Títulos === */
    #articleBody h2 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--accent, #A855F7);
      margin: 3rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border, #1C1C2E);
    }
    #articleBody h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary, #efecfb);
      margin: 2rem 0 0.75rem;
    }

    /* === Âncoras (scroll sob o header fixo) === */
    #articleBody [id] {
      scroll-margin-top: calc(var(--nav-height, 101px) + 32px);
    }

    /* === Seções === */
    #articleBody .article-section {
      background: var(--bg-card, #0A0A0F);
      border: 1px solid var(--border, #1C1C2E);
      border-radius: var(--radius-lg, 14px);
      padding: 2rem;
      margin: 3rem 0;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        inset 0 -1px 0 rgba(0, 0, 0, 0.3),
        0 2px 4px rgba(0, 0, 0, 0.3),
        0 8px 24px rgba(0, 0, 0, 0.4);
    }
    #articleBody > .article-section:first-of-type {
      margin-top: 2rem;
    }
    #articleBody .article-section h2 {
      margin: 0 0 1rem;
    }
    #articleBody .article-section > .article-game-img:first-child {
      margin-top: 0;
    }
    #articleBody .article-section > .article-game-img:last-child {
      margin-bottom: 0;
    }

    /* === Sub-cards (itens de lista, FAQ, dicas) === */
    #articleBody .article-subsection {
      background: rgba(47, 248, 1, 0.03);
      border: 1px solid var(--border, #1C1C2E);
      border-left: 3px solid #2ff801;
      border-radius: 0 10px 10px 0;
      padding: 1.25rem 1.5rem;
      margin: 1.5rem 0;
    }
    #articleBody .article-subsection:nth-of-type(odd) {
      background: rgba(47, 248, 1, 0.05);
    }
    #articleBody .article-subsection > h3,
    #articleBody .article-subsection h3 strong {
      color: #2ff801;
    }
    #articleBody .article-subsection h3 {
      margin: 0 0 0.75rem;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.3;
    }
    #articleBody .article-subsection strong {
      color: #2ff801;
    }
    #articleBody .article-subsection > .article-game-img {
      margin: 0.25rem auto 1.25rem;
    }
    #articleBody .article-subsection > .article-game-img:first-of-type {
      margin-top: 0;
    }
    #articleBody .article-subsection > .product-btn {
      margin-top: 1rem;
    }

    /* === FAQ acordeao (TAREFA 3.3) === */
    #articleBody .faq-item {
      background: rgba(47, 248, 1, 0.03);
      border: 1px solid var(--border, #1C1C2E);
      border-left: 3px solid #2ff801;
      border-radius: 0 10px 10px 0;
      margin: 1rem 0;
      overflow: hidden;
    }
    #articleBody .faq-item > summary {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
      list-style: none;
      padding: 1rem 1.25rem;
      font-size: 1.1rem;
      font-weight: 600;
      color: #2ff801;
      user-select: none;
    }
    #articleBody .faq-item > summary::-webkit-details-marker {
      display: none;
    }
    #articleBody .faq-item > summary h3 {
      margin: 0;
      font-size: inherit;
      font-weight: inherit;
      color: inherit;
      display: inline;
    }
    #articleBody .faq-item > summary::after {
      content: "";
      width: 0.5rem;
      height: 0.5rem;
      margin-left: auto;
      flex-shrink: 0;
      border-right: 2px solid var(--accent, #A855F7);
      border-bottom: 2px solid var(--accent, #A855F7);
      transform: rotate(-45deg);
      transition: transform var(--transition, 0.2s) ease;
    }
    #articleBody .faq-item[open] > summary::after {
      transform: rotate(45deg);
    }
    #articleBody .faq-item > :not(summary) {
      padding: 0 1.25rem 1.25rem;
    }

    /* === Fontes === */
    #articleBody ul li a {
      color: var(--accent, #A855F7);
      text-decoration: none;
      transition: color 0.2s;
    }
    #articleBody ul li a:hover {
      color: #2ff801;
      text-decoration: underline;
    }

    @media (max-width: 640px) {
      #articleBody .article-section {
        padding: 1.25rem;
      }
      #articleBody .product-card-body {
        padding: 1rem;
      }
      #articleBody .product-card-body h3 {
        font-size: 1.1rem;
      }
      #articleBody .article-subsection {
        padding: 1rem 1.25rem;
      }
    }
  </style>
</Layout>
