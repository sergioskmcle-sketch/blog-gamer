---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Sidebar from "../../components/Sidebar.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { tagSlug } from "../../lib/slug";

export async function getStaticPaths() {
  const artigos = Object.entries(import.meta.glob("../../content/artigos/*.md", { eager: true })).map(
    ([path, mod]) => ({
      slug: path.split("/").pop()?.replace(".md", "") || "",
      ...mod.frontmatter,
    })
  );

  const porTag = new Map();
  for (const artigo of artigos) {
    for (const tag of artigo.tags || []) {
      const s = tagSlug(tag);
      if (!s) continue;
      if (!porTag.has(s)) porTag.set(s, { label: tag, artigos: [] });
      porTag.get(s).artigos.push(artigo);
    }
  }

  return [...porTag.entries()].map(([s, { label, artigos: lista }]) => ({
    params: { slug: s },
    props: {
      label,
      artigos: lista.sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()),
      todos: artigos.sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()),
    },
  }));
}

const { label, artigos, todos } = Astro.props;
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
---

<Layout
  title={`${label} — Promo Gamer`}
  description={`Todos os artigos sobre ${label} no Promo Gamer: notícias, reviews e guias.`}
  noindex={artigos.length < 2}
>
  <div class="max-w-page mx-auto px-gutter">
    <div class="grid grid-cols-1 gap-xl my-xl blog-layout">
      <section class="min-w-0 space-y-xl" style="grid-column: span var(--main-cols, 8) / span var(--main-cols, 8)">
        <div class="border-b border-outline-variant/30 pb-lg">
          <div class="mb-md">
            <Breadcrumbs items={[{ name: "Início", href: base }, { name: label }]} />
          </div>
          <p class="font-label text-label text-primary uppercase tracking-widest mb-xs">Tag</p>
          <h1 class="font-h1 text-h1 text-on-surface">{label}</h1>
          <p class="text-on-surface-variant mt-sm">
            {artigos.length} {artigos.length === 1 ? "artigo" : "artigos"}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
          {artigos.map((artigo) => (
            <ArticleCard
              title={artigo.title}
              description={artigo.description}
              pubDate={artigo.pubDate}
              tags={artigo.tags}
              category={artigo.category}
              affiliate={artigo.affiliate}
              slug={artigo.slug}
              image={artigo.image}
            />
          ))}
        </div>
      </section>

      <aside class="min-w-0" style="grid-column: span var(--sidebar-cols, 4) / span var(--sidebar-cols, 4)">
        <Sidebar artigos={todos} currentSlug={undefined} />
      </aside>
    </div>
  </div>
</Layout>
