---
import "../styles/global.css";
import "../styles/effects.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import EditorBridge from "../components/EditorBridge.astro";
import blogConfig from "../data/blog-config.json";
import backgroundPresets from "../data/background-presets.json";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  pubDate?: string;
  tags?: string[];
  category?: string;
  noindex?: boolean;
}

const { title, description, image, pubDate, tags, category, noindex } = Astro.props;
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\/$/, "") + "/";
const canonicalURL = new URL(canonicalPath, Astro.site);

const searchArticles = Object.entries(import.meta.glob("../content/artigos/*.md", { eager: true }))
  .map(([path, mod]) => ({
    title: mod.frontmatter.title,
    url: `${base}blog/${path.split("/").pop()?.replace(".md", "")}/`,
    category: mod.frontmatter.category,
    tags: mod.frontmatter.tags || [],
    date: mod.frontmatter.pubDate ? new Date(mod.frontmatter.pubDate).toLocaleDateString("pt-BR") : "",
  }));

const defaultTheme = blogConfig.theme === "light" ? "light" : "dark";
const defaultThemeJson = JSON.stringify(defaultTheme);

const bg = blogConfig.background || {};
let bgVars = "--body-bg-image: none !important;";
if (bg.mode === "preset") {
  const preset = (backgroundPresets || []).find((p) => p.id === bg.preset) || backgroundPresets?.[0];
  if (preset) {
    bgVars = `
      --body-bg-color: ${preset.color || "#050505"};
      --body-bg-image: ${preset.image || "none"} !important;
      --body-bg-size: ${preset.size || "auto"};
      --body-bg-position: ${preset.position || "0 0"};
      --body-bg-repeat: ${preset.repeat || "repeat"};
      --body-bg-attachment: ${preset.attachment || "scroll"};
    `;
  }
} else if (bg.mode === "image") {
  const overlay = Math.min(Math.max(Number(bg.overlayOpacity) || 0, 0), 1);
  const img = (bg.imageUrl || "").trim();
  const overlayLayer = `linear-gradient(rgba(0, 0, 0, ${overlay.toFixed(2)}), rgba(0, 0, 0, ${overlay.toFixed(2)}))`;
  bgVars = `
    --body-bg-color: ${bg.solidColor || "#050505"};
    --body-bg-image: ${img ? `${overlayLayer}, url('${img}')` : "none"} !important;
    --body-bg-size: ${bg.imageSize || "cover"};
    --body-bg-position: ${bg.imagePosition || "center center"};
    --body-bg-repeat: ${bg.imageRepeat || "no-repeat"};
    --body-bg-attachment: ${bg.imageAttachment || "fixed"};
  `;
} else if (bg.mode === "solid") {
  bgVars = `
    --body-bg-color: ${bg.solidColor || "#050505"};
    --body-bg-image: none !important;
  `;
}

const themeCss = `:root:root {\n${bgVars.trim()}\n}`;

const themeScript = `(function () {
  var DEFAULT = ${defaultThemeJson};
  var saved = null;
  try { saved = localStorage.getItem("blog-theme"); } catch (e) {}
  var theme = saved || DEFAULT || "dark";
  if (theme !== "light") theme = "dark";
  document.documentElement.setAttribute("data-theme", theme);
  document.documentElement.classList.toggle("dark", theme === "dark");
  document.documentElement.classList.toggle("light", theme === "light");
  var meta = document.querySelector('meta[name="theme-color"]');
  if (meta) meta.setAttribute("content", theme === "dark" ? "#050505" : "#F5F5F7");
})();`;
---

<!doctype html>
<html lang="pt-BR" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050505" />
    <script is:inline set:html={themeScript}></script>
    <meta name="google-site-verification" content="kOOZLZ1vJ0aNnQUkmNDReiwSoYUJKZB0p-inN6ziszc" />
    <meta name="description" content={description || "Promo Gamer — notícias, reviews e guias do mundo dos games"} />

    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Blog sobre o mundo gamer"} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content={pubDate ? "article" : "website"} />
    <meta property="og:site_name" content="Promo Gamer" />
    {image && (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {image && <meta name="twitter:image" content={image} />}

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Public+Sans:wght@400;500;600;700;900&family=Orbitron:wght@700;900&display=swap&subset=latin" rel="stylesheet" />

    {pubDate && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description: description || "Artigo do Promo Gamer sobre o mundo dos games",
        url: canonicalURL.href,
        image: image || `${base}images/og-default.png`,
        datePublished: pubDate,
        dateModified: pubDate,
        author: {
          "@type": "Organization",
          name: "Promo Gamer",
          url: Astro.site?.href || `${base}`,
        },
        publisher: {
          "@type": "Organization",
          name: "Promo Gamer",
          logo: {
            "@type": "ImageObject",
            url: `${base}favicon.svg`,
          },
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalURL.href,
        },
        keywords: tags?.join(", ") || "games, noticias, reviews",
        articleSection: category || "Games",
      })} />
    )}

    <title>{title} — Promo Gamer</title>
    <style is:inline set:html={themeCss}></style>
  </head>
  <body class="font-body selection:bg-primary selection:text-on-primary">
    <Header />
    <main style="padding-top: calc(max(var(--content-top, var(--nav-height)), var(--nav-height)) + 8px)">
      <slot />
    </main>

    <Footer />
    <SearchOverlay />
    <EditorBridge />
    <script type="application/json" id="searchData" set:html={JSON.stringify(searchArticles)}></script>
  </body>
</html>
