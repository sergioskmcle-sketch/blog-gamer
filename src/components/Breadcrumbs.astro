---
export interface Crumb {
  name: string;
  /** Ausente no último item (a página atual) */
  href?: string;
}

export interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, "") ?? "";

// BreadcrumbList habilita o rich snippet de trilha no Google.
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.name,
    ...(item.href ? { item: `${site}${item.href}` } : {}),
  })),
};
---

<nav aria-label="Trilha de navegação" class="breadcrumbs">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href ? (
          <a href={item.href}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
        {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }

  .breadcrumbs a,
  .breadcrumbs [aria-current="page"] {
    /* Alvo de ponteiro de 36px — links de trilha não precisam dos 44px de um
       botão principal, mas 23px de altura era pequeno demais no toque. */
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }

  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .breadcrumbs a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--text-secondary);
    /* Títulos longos não devem empurrar a trilha para várias linhas */
    max-width: 34ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .breadcrumbs .sep {
    color: var(--border-hover);
  }
</style>
