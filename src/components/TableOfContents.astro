---
import Icon from "./Icon.astro";

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

interface Topic extends Heading {
  subs: Heading[];
}

const stripNumber = (text: string) => text.replace(/^\d+\.\s+/, "");

const tree: Topic[] = [];
let lastTopic: Topic | null = null;
for (const h of headings) {
  if (h.depth === 2) {
    lastTopic = { ...h, subs: [] };
    tree.push(lastTopic);
  } else if (h.depth === 3) {
    if (!lastTopic) {
      lastTopic = { depth: 2, slug: h.slug, text: h.text, subs: [] };
      tree.push(lastTopic);
    }
    lastTopic.subs.push(h);
  }
}
---

{headings.length >= 3 && (
  <details class="toc-inline">
    <summary>
      <Icon name="list" size={18} />
      <span>Neste artigo</span>
      <span class="toc-count">{headings.length}</span>
    </summary>
    <ol class="toc-list list-none p-0">
      {tree.map((topic, ti) => {
        const topicNum = String(ti + 1).padStart(2, "0");
        return (
          <li class="toc-topic">
            <a href={`#${topic.slug}`} class="toc-link toc-link-topic">
              <span class="toc-num">{topicNum}</span>
              <span>{topic.text}</span>
            </a>
            {topic.subs.length > 0 && (
              <ol class="toc-sublist list-none p-0">
                {topic.subs.map((sub, si) => (
                  <li>
                    <a href={`#${sub.slug}`} class="toc-link toc-link-sub">
                      <span class="toc-num">
                        {topicNum}.{si + 1}
                      </span>
                      <span>{stripNumber(sub.text)}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        );
      })}
    </ol>
  </details>
)}

<style>
  .toc-link {
    display: flex;
    gap: 0.625rem;
    align-items: baseline;
    min-height: 40px;
    padding: 0.625rem;
    border-radius: 8px;
    border-left: 2px solid transparent;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color var(--transition), background var(--transition),
      border-color var(--transition);
  }

  .toc-link:hover {
    color: var(--text-primary);
    background: rgba(168, 85, 247, 0.06);
    text-decoration: none;
  }

  .toc-num {
    flex-shrink: 0;
    font-family: var(--font-label);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .toc-topic {
    border-bottom: 1px solid var(--border);
  }

  .toc-topic:last-child {
    border-bottom: none;
  }

  .toc-sublist {
    margin: 0 0 0.25rem 1.25rem;
    border-left: 1px solid var(--border);
  }

  .toc-link-sub {
    min-height: 32px;
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
  }

  .toc-inline {
    margin: 0 auto 2rem;
    max-width: min(720px, 100%);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .toc-inline summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    /* 48px de altura — área de toque adequada */
    padding: 0.875rem 1rem;
    cursor: pointer;
    color: var(--text-primary);
    font-family: var(--font-label);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    list-style: none;
  }

  .toc-inline summary::-webkit-details-marker {
    display: none;
  }

  .toc-count {
    margin-left: auto;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-size: 0.6875rem;
  }

  .toc-inline[open] summary {
    border-bottom: 1px solid var(--border);
  }

  .toc-inline .toc-list {
    padding: 0.5rem;
    margin: 0;
  }

  .toc-inline .toc-link {
    padding: 0.75rem 0.625rem;
  }
</style>
