---
import Icon from "./Icon.astro";

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

interface Topic extends Heading {
  subs: Heading[];
}

const stripNumber = (text: string) => text.replace(/^\d+\.\s+/, "");

const tree: Topic[] = [];
let lastTopic: Topic | null = null;
for (const h of headings) {
  if (h.depth === 2) {
    lastTopic = { ...h, subs: [] };
    tree.push(lastTopic);
  } else if (h.depth === 3) {
    if (!lastTopic) {
      lastTopic = { depth: 2, slug: h.slug, text: h.text, subs: [] };
      tree.push(lastTopic);
    }
    lastTopic.subs.push(h);
  }
}
---

{headings.length >= 3 && (
  <div class="toc-inline">
    <div class="toc-header">
      <Icon name="list" size={18} />
      <span>Neste artigo</span>
      <span class="toc-count">{headings.length}</span>
    </div>
    <ol class="toc-list list-none p-0">
      {tree.map((topic, ti) => {
        const topicNum = String(ti + 1);
        const topicLink = (
          <a href={`#${topic.slug}`} class="toc-link toc-link-topic">
            <span class="toc-num">{topicNum}</span>
            <span>{topic.text}</span>
          </a>
        );
        return (
          <li class="toc-topic">
            {topic.subs.length > 0 ? (
              <details class="toc-topic-details">
                <summary>
                  {topicLink}
                  <span class="toc-chevron">
                    <Icon name="chevron_right" size={18} />
                  </span>
                </summary>
                <ol class="toc-sublist list-none p-0">
                  {topic.subs.map((sub, si) => (
                    <li>
                      <a href={`#${sub.slug}`} class="toc-link toc-link-sub">
                        <span class="toc-num">
                          {topicNum}.{si + 1}
                        </span>
                        <span>{stripNumber(sub.text)}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            ) : (
              topicLink
            )}
          </li>
        );
      })}
    </ol>
  </div>
)}

<style>
  .toc-inline {
    margin: 0 0 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    color: var(--text-primary);
    font-family: var(--font-label);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .toc-count {
    margin-left: auto;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-size: 0.6875rem;
  }

  .toc-list {
    padding: 0.5rem;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .toc-topic {
    border-bottom: 1px solid var(--border);
  }

  .toc-topic:last-child {
    border-bottom: none;
  }

  .toc-topic-details > summary {
    display: flex;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }

  .toc-topic-details > summary::-webkit-details-marker {
    display: none;
  }

  .toc-chevron {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    margin-left: 0.375rem;
    color: var(--accent);
    transition: transform var(--transition);
  }

  .toc-topic-details[open] .toc-chevron {
    transform: rotate(90deg);
  }

  .toc-link {
    display: flex;
    gap: 0.625rem;
    align-items: baseline;
    min-height: 48px;
    padding: 0.75rem 0.625rem;
    border-radius: 8px;
    border-left: 2px solid transparent;
    color: var(--accent);
    font-size: 1.2rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color var(--transition), background var(--transition),
      border-color var(--transition);
  }

  .toc-link:hover {
    color: var(--accent-hover);
    background: rgba(168, 85, 247, 0.06);
    text-decoration: none;
  }

  .toc-link-topic {
    flex: 1;
    min-width: 0;
  }

  .toc-num {
    flex-shrink: 0;
    font-family: var(--font-label);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .toc-sublist {
    margin: 0 0 0.25rem 1.25rem;
    border-left: 1px solid var(--border);
  }

  .toc-link-sub {
    min-height: 36px;
    padding: 0.5rem 0.625rem;
    color: #c4b5fd;
    font-size: 1.05rem;
  }

  .toc-link-sub:hover {
    color: #fff;
  }
</style>
