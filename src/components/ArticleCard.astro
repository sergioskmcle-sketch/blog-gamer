---
export interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  tags?: string[];
  category?: string;
  affiliate?: boolean;
  slug: string;
  image?: string;
}

const { title, description, pubDate, tags, category, affiliate, slug, image } = Astro.props;
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");

const timeAgo = (date: Date | string) => {
  const now = new Date();
  const d = new Date(date);
  const diffMs = now.getTime() - d.getTime();
  const diffHrs = Math.floor(diffMs / 3600000);
  if (diffHrs < 1) return "Agora mesmo";
  if (diffHrs < 24) return `${diffHrs}h atrás`;
  const diffDays = Math.floor(diffHrs / 24);
  if (diffDays < 7) return `${diffDays}d atrás`;
  return d.toLocaleDateString("pt-BR");
};

const badgeByCategory: Record<string, string> = {
  review: "bg-primary/80 text-white",
  noticia: "bg-surface-bright/80 text-on-surface",
  guia: "bg-secondary/80 text-surface",
  promocao: "bg-error/80 text-on-error",
};
const badgeClass = badgeByCategory[category?.toLowerCase() || ""] || "bg-primary/80 text-white";
---

<article class="bg-surface-container rounded-xl overflow-hidden hover:bg-surface-container-high transition-colors group cursor-pointer flex flex-col h-full border border-outline-variant hover:border-secondary/50 hover:shadow-[0_0_20px_var(--accent-glow)]">
  <a href={`${base}blog/${slug}/`} class="no-underline hover:no-underline text-inherit flex flex-col flex-1">
    <div class="relative w-full pt-[56.25%] overflow-hidden">
      {image ? (
        <div
          class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-110"
          style={`background-image: url('${image}')`}
        />
      ) : (
        <div class="absolute inset-0 bg-surface-container-high flex items-center justify-center text-4xl"></div>
      )}
      {category && (
        <span class={`absolute top-3 left-3 ${badgeClass} font-label-md text-label-md px-2 py-1 rounded backdrop-blur-sm uppercase`}>
          {category}
        </span>
      )}
    </div>

    <div class="p-md flex flex-col flex-grow gap-sm">
      <h3 class="font-headline-md text-headline-md text-on-surface group-hover:text-secondary transition-colors line-clamp-2">
        {title}
      </h3>

      <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2 mt-auto">
        {description}
      </p>

      <div class="flex items-center gap-sm text-on-surface-variant font-body-md text-[14px] mt-sm">
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]" aria-hidden="true">calendar_today</span>
          {timeAgo(pubDate)}
        </span>
      </div>
    </div>
  </a>
</article>
