---
export interface Artigo {
  title: string;
  slug: string;
  pubDate: Date | string;
  category?: string;
  image?: string;
}

const { artigos, currentSlug }: { artigos: Artigo[]; currentSlug?: string } = Astro.props;
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");

const recentes = artigos.filter((a) => a.slug !== currentSlug).slice(0, 10);

const categories = [
  { name: "Notícias", slug: "noticia" },
  { name: "Reviews", slug: "review" },
  { name: "Guias", slug: "guia" },
  { name: "Listas", slug: "lista" },
  { name: "Promoções", slug: "promocao" },
];
---

<aside class="flex flex-col gap-lg" data-editable="sidebar">
  <div class="bg-surface-container rounded-xl p-md border border-outline-variant relative overflow-hidden">
    <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-full blur-2xl -mr-16 -mt-16 pointer-events-none"></div>
    <h3 class="font-headline-md text-headline-md text-on-surface mb-md flex items-center gap-2">
      <span class="material-symbols-outlined text-primary" aria-hidden="true">trending_up</span>
      Populares da Semana
    </h3>
    <div class="flex flex-col gap-md">
      {recentes.length === 0 && <p class="text-on-surface-variant text-xs">Nenhum artigo publicado ainda.</p>}
      {recentes.slice(0, 4).map((artigo, idx) => (
        <a class="flex gap-sm group items-start no-underline hover:no-underline" href={`${base}blog/${artigo.slug}/`}>
          <span class="font-headline-md text-headline-md text-outline group-hover:text-secondary/50 transition-colors w-8 text-center flex-shrink-0">
            {idx + 1}
          </span>
          <div class="flex flex-col gap-1">
            <h4 class="font-body-md text-body-md text-on-surface-variant group-hover:text-secondary transition-colors line-clamp-2 leading-tight">
              {artigo.title}
            </h4>
            <span class="font-label-md text-label-md text-on-surface-variant uppercase">{artigo.category || "Artigo"}</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <a
    href="https://t.me/+TRWZ67WHuk85Y2Nh"
    target="_blank"
    rel="noopener noreferrer"
    class="block rounded-xl overflow-hidden border border-outline-variant no-underline hover:no-underline"
  >
    <img
      src={`${base}images/banner-grupo-9x16-2.webp`}
      alt="Grupo VIP Telegram - Ofertas Gamer Diárias"
      class="w-full h-auto"
      loading="lazy"
      decoding="async"
    />
  </a>

  <div class="bg-surface-container rounded-xl p-md border border-outline-variant">
    <h3 class="font-headline-md text-headline-md text-on-surface mb-md">Categorias</h3>
    <div class="flex flex-wrap gap-2">
      {categories.map((cat) => (
        <a
          href={`${base}categoria/${cat.slug}/`}
          class="px-3 py-1.5 rounded bg-surface-container-high hover:bg-secondary/20 text-on-surface-variant hover:text-secondary transition-colors font-label-md text-label-md uppercase border border-transparent hover:border-secondary/50 no-underline hover:no-underline"
        >
          {cat.name}
        </a>
      ))}
    </div>
  </div>

  <div class="bg-surface-container-high rounded-xl p-md flex flex-col items-center justify-center text-center gap-sm border border-outline-variant">
    <span class="material-symbols-outlined text-primary text-[48px] mb-2" aria-hidden="true">mail</span>
    <h4 class="font-headline-md text-headline-md text-on-surface">Não perca nada</h4>
    <p class="font-body-md text-body-md text-on-surface-variant mb-2">Inscreva-se na nossa newsletter para receber as melhores reviews e ofertas semanais.</p>
    <div class="w-full flex">
      <input
        class="w-full bg-surface text-on-surface font-body-md p-3 rounded-l-lg border-y border-l border-outline-variant focus:outline-none focus:border-secondary/50 focus:ring-1 focus:ring-secondary/50 transition-all placeholder:text-on-surface-variant"
        placeholder="Seu e-mail..."
        type="email"
        aria-label="Seu e-mail"
      />
      <button class="bg-primary text-white font-label-md text-label-md uppercase px-4 rounded-r-lg hover:bg-primary-fixed-dim transition-colors font-bold whitespace-nowrap">
        Assinar
      </button>
    </div>
    <p class="font-label text-[10px] text-on-surface-variant/70">
      Links de afiliado ajudam a manter o blog.
    </p>
  </div>
</aside>
