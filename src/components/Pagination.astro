---
import Icon from "./Icon.astro";

export interface Props {
  currentPage: number;
  lastPage: number;
  urlPrev?: string;
  urlNext?: string;
  /** Monta a URL de uma página arbitrária */
  hrefFor: (page: number) => string;
}

const { currentPage, lastPage, urlPrev, urlNext, hrefFor } = Astro.props;

/**
 * Janela de páginas: sempre mostra a primeira, a última, a atual e as
 * vizinhas. O resto vira "…" para a barra não crescer sem limite.
 */
function janela(current: number, last: number): (number | "gap")[] {
  const pages = new Set<number>([1, last, current]);
  if (current - 1 > 1) pages.add(current - 1);
  if (current + 1 < last) pages.add(current + 1);

  const sorted = [...pages].filter((p) => p >= 1 && p <= last).sort((a, b) => a - b);
  const out: (number | "gap")[] = [];
  sorted.forEach((p, i) => {
    if (i > 0 && p - sorted[i - 1] > 1) out.push("gap");
    out.push(p);
  });
  return out;
}

const itens = janela(currentPage, lastPage);
---

{lastPage > 1 && (
  <nav class="pagination" aria-label="Paginação">
    <a
      href={urlPrev}
      class="page-arrow"
      aria-label="Página anterior"
      aria-disabled={urlPrev ? undefined : "true"}
    >
      <Icon name="arrow_back" size={18} />
      <span class="arrow-label">Anterior</span>
    </a>

    <ol class="page-list">
      {itens.map((item) =>
        item === "gap" ? (
          <li class="gap" aria-hidden="true">…</li>
        ) : (
          <li>
            <a
              href={hrefFor(item)}
              class="page-num"
              aria-current={item === currentPage ? "page" : undefined}
            >
              {item}
            </a>
          </li>
        )
      )}
    </ol>

    <a
      href={urlNext}
      class="page-arrow"
      aria-label="Próxima página"
      aria-disabled={urlNext ? undefined : "true"}
    >
      <span class="arrow-label">Próxima</span>
      <Icon name="arrow_forward" size={18} />
    </a>
  </nav>
)}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  .page-list {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-list li {
    margin: 0;
  }

  .page-num,
  .page-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    /* 44px de alvo de toque */
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-family: var(--font-label);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: color var(--transition), border-color var(--transition);
  }

  .page-num:hover,
  .page-arrow:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .page-num[aria-current="page"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent, #fff);
  }

  .page-arrow[aria-disabled="true"] {
    opacity: 0.35;
    pointer-events: none;
  }

  .gap {
    padding: 0 0.25rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .arrow-label {
      display: none;
    }
  }
</style>
